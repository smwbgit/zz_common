BasedOnStyle: Microsoft

# 语言：C++（也支持 Java、JavaScript 等）
Language: Cpp

# 访问修饰符（public/private）的缩进偏移量
# -2 表示比 class 缩进少 2 格，即 public: 比 class 靠左一点
AccessModifierOffset: -4

# 开括号后的对齐方式：Align = 参数与括号对齐
AlignAfterOpenBracket: DontAlign

# 结构体数组对齐：None = 不对齐
AlignArrayOfStructures: None

# 连续赋值语句的对齐（如 a = 1; b = 2;）
# 默认关闭，不强制等号对齐
AlignConsecutiveAssignments:
  Enabled: false
  AcrossEmptyLines: false
  AcrossComments: false
  AlignCompound: false
  AlignFunctionDeclarations: false
  AlignFunctionPointers: false
  PadOperators: true

# 连续位域对齐（如 int a:1; int b:2;）
AlignConsecutiveBitFields:
  Enabled: false
  # ... 同上结构，默认关闭

# 连续声明对齐（如 int a; int b;）
AlignConsecutiveDeclarations:
  Enabled: false
  AlignFunctionDeclarations: true  # 函数声明之间对齐
  # ... 其余关闭

# 连续宏定义对齐
AlignConsecutiveMacros:
  Enabled: false

# 短 case 语句对齐
AlignConsecutiveShortCaseStatements:
  Enabled: false

# TableGen 专用（LLVM 工具链），普通 C++ 不用关心
AlignConsecutiveTableGenBreakingDAGArgColons:
  Enabled: false
AlignConsecutiveTableGenCondOperatorColons:
  Enabled: false
AlignConsecutiveTableGenDefinitionColons:
  Enabled: false

# 换行符前反斜杠的对齐：Right = 靠右对齐
AlignEscapedNewlines: Right

# 操作数对齐：Align = 二元操作符两侧对齐
AlignOperands: Align

# 行尾注释对齐
AlignTrailingComments:
  Kind: Always      # 总是对齐
  OverEmptyLines: 0  # 空行上方不延续对齐

# 允许所有参数换到下一行
AllowAllArgumentsOnNextLine: true

# 允许函数声明的所有参数换到下一行
AllowAllParametersOfDeclarationOnNextLine: true

# noexcept 说明符前是否换行：Never = 不换
AllowBreakBeforeNoexceptSpecifier: Never

# Qt 属性前是否换行
AllowBreakBeforeQtProperty: false

# 短代码块是否允许单行：Never = 不允许
AllowShortBlocksOnASingleLine: Never

# 短 case 表达式单行：true = 允许
AllowShortCaseExpressionOnASingleLine: true

# 短 case 标签单行：false = 不允许
AllowShortCaseLabelsOnASingleLine: false

# 短复合要求单行（C++20 概念）
AllowShortCompoundRequirementOnASingleLine: true

# 短枚举是否单行：false = 展开写
AllowShortEnumsOnASingleLine: false

# 短函数是否单行：None = 都不允许（即使空函数也展开）
AllowShortFunctionsOnASingleLine: None

# 短 if 语句是否单行：Never = 不允许
AllowShortIfStatementsOnASingleLine: Never

# 短 Lambda 是否单行：All = 都允许
AllowShortLambdasOnASingleLine: All

# 短循环是否单行：false = 不允许
AllowShortLoopsOnASingleLine: false

# 短命名空间是否单行：false = 不允许
AllowShortNamespacesOnASingleLine: false

# 函数返回类型后是否换行：None = 不换
AlwaysBreakAfterDefinitionReturnType: None

# 多行字符串前是否换行：false = 不换
AlwaysBreakBeforeMultilineStrings: false

# 属性宏列表（如 __capability）
AttributeMacros:
  - __capability

# 参数打包：true = 尽量把参数挤在一行
BinPackArguments: true

# 长花括号列表打包
BinPackLongBracedList: true

# 函数参数打包策略：BinPack = 尽量打包
BinPackParameters: BinPack

# 位域冒号两侧空格：Both = 两边都加空格
BitFieldColonSpacing: Both

# 花括号初始化列表的缩进宽度：-1 = 跟随 IndentWidth
BracedInitializerIndentWidth: -1

# 大括号换行详细控制（Allman 风格的具体展开）
BraceWrapping:
  AfterCaseLabel: true       # case 标签后换行
  AfterClass: true           # class 定义后换行
  AfterControlStatement: Always  # if/for/while 后换行
  AfterEnum: true            # enum 后换行
  AfterExternBlock: true     # extern "C" 后换行
  AfterFunction: true        # 函数定义后换行
  AfterNamespace: true       # namespace 后换行
  AfterObjCDeclaration: true
  AfterStruct: true         # struct 后换行
  AfterUnion: true          # union 后换行
  BeforeCatch: true         # catch 前换行
  BeforeElse: true          # else 前换行
  BeforeLambdaBody: true    # lambda 体前换行
  BeforeWhile: false        # do-while 的 while 前不换行
  IndentBraces: false       # 大括号本身不额外缩进
  SplitEmptyFunction: true  # 空函数也换行
  SplitEmptyRecord: true    # 空类/结构体也换行
  SplitEmptyNamespace: true # 空命名空间也换行

# 相邻字符串字面量是否换行分割
BreakAdjacentStringLiterals: true

# 属性后换行策略：Leave = 保持原样
BreakAfterAttributes: Leave

# Java 字段注解后换行（对 C++ 无效）
BreakAfterJavaFieldAnnotations: false

# 返回类型后换行：None = 不换
BreakAfterReturnType: None

# 数组初始化是否换行：true = 允许
BreakArrays: true

# 二元操作符前换行：None = 操作符后换行（如 a + 换行 b）
BreakBeforeBinaryOperators: None

# 概念声明前换行：Always = 总是
BreakBeforeConceptDeclarations: Always

# 大括号风格：Allman = 另起一行（与 BraceWrapping 配套）
BreakBeforeBraces: Allman

# 内联汇编冒号换行：OnlyMultiline = 多行时才考虑
BreakBeforeInlineASMColon: OnlyMultiline

# 模板关闭符前换行：false = 不换
BreakBeforeTemplateCloser: false

# 三元操作符前换行：true = ? 和 : 前面换行
BreakBeforeTernaryOperators: true

# 二元操作换行：Never = 不主动断开
BreakBinaryOperations: Never

# 构造初始化列表换行：BeforeColon = 冒号前换行
BreakConstructorInitializers: BeforeColon

# 函数定义参数换行：false = 不特殊处理
BreakFunctionDefinitionParameters: false

# 继承列表换行：BeforeColon = 冒号前换行
BreakInheritanceList: BeforeColon

# 字符串字面量过长时是否断开：true = 断开
BreakStringLiterals: true

# 模板声明换行：MultiLine = 多行参数时换行
BreakTemplateDeclarations: MultiLine

# 行宽限制：0 = 无限制（不自动换行）
ColumnLimit: 0

# 注释中的特殊标记，遇到此正则不格式化该注释
CommentPragmas: '^ IWYU pragma:'

# 紧凑命名空间：false = 不合并空命名空间
CompactNamespaces: false

# 构造初始化列表的缩进宽度：4
ConstructorInitializerIndentWidth: 4

# 续行（换行后第二行）的缩进宽度：4
ContinuationIndentWidth: 4

# C++11 花括号列表风格：true = 逗号后空格等现代风格
Cpp11BracedListStyle: true

# 是否从代码推导指针/引用对齐方式：false = 使用配置值
DerivePointerAlignment: false

# 禁用格式化：false = 正常格式化
DisableFormat: false

# 访问修饰符后是否空行：Never = 不加
EmptyLineAfterAccessModifier: Never

# 访问修饰符前空行：LogicalBlock = 逻辑块前加空行
EmptyLineBeforeAccessModifier: LogicalBlock

# 枚举尾部逗号：Leave = 保持原样
EnumTrailingComma: Leave

# 自动检测参数打包：false = 关闭
ExperimentalAutoDetectBinPacking: false

# 修复命名空间尾部注释：true = 自动补全 // namespace XXX
FixNamespaceComments: false

# foreach 类宏列表（识别为循环结构）
ForEachMacros:
  - foreach
  - Q_FOREACH
  - BOOST_FOREACH

# 条件宏列表（识别为 if 结构）
IfMacros:
  - KJ_IF_MAYBE

# #include 块处理：Preserve = 保持原有分组
IncludeBlocks: Preserve

# #include 分类排序规则（按正则匹配优先级）
IncludeCategories:
  - Regex: '^"(llvm|llvm-c|clang|clang-c)/'
    Priority: 2
    SortPriority: 0
    CaseSensitive: false
  - Regex: '^(<|<|"(gtest|gmock|isl|json)/)'
    Priority: 3
    SortPriority: 0
    CaseSensitive: false
  - Regex: '.*'
    Priority: 1
    SortPriority: 0
    CaseSensitive: false

# 判断主文件的正则：以 Test 结尾或没有后缀
IncludeIsMainRegex: '(Test)?$'
IncludeIsMainSourceRegex: ''

# 访问修饰符是否缩进：false = 不缩进（顶格写 public:）
IndentAccessModifiers: false

# case 块是否缩进：false = switch 和 case 同级
IndentCaseBlocks: false

# case 标签是否缩进：false = 不缩进（与 switch 对齐）
IndentCaseLabels: false

# export 块缩进：true = 缩进
IndentExportBlock: true

# extern 块缩进：AfterExternBlock = extern 内部缩进
IndentExternBlock: AfterExternBlock

# goto 标签缩进：true = 缩进（而不是顶格）
IndentGotoLabels: true

# 预处理器指令缩进：None = # 顶格
IndentPPDirectives: None

# requires 子句缩进：true = 缩进
IndentRequiresClause: true

# 缩进宽度：4（与 TabWidth 配合）
IndentWidth: 4

# 换行后的函数名是否缩进：false = 不缩进
IndentWrappedFunctionNames: false

# 是否自动插入大括号：false = 不插入
InsertBraces: false

# 文件末尾自动插入换行：false = 不插入
InsertNewlineAtEOF: false

# 尾部逗号插入：None = 不自动加
InsertTrailingCommas: None

# 数字字面量分隔符（如 1'000'000），0 = 不插入
IntegerLiteralSeparator:
  Binary: 0
  BinaryMinDigits: 0
  Decimal: 0
  DecimalMinDigits: 0
  Hex: 0
  HexMinDigits: 0

# JavaScript 引号：Leave = 保持原样
JavaScriptQuotes: Leave

# JavaScript 导入换行：true = 换行
JavaScriptWrapImports: true

# 空行保留策略
KeepEmptyLines:
  AtEndOfFile: false      # 文件末尾不留空行
  AtStartOfBlock: true    # 代码块开头保留空行
  AtStartOfFile: true     # 文件开头保留空行

# 保留换页符：false = 删除
KeepFormFeed: false

# Lambda 体缩进：Signature = 与签名对齐
LambdaBodyIndentation: OuterScope

# 换行符：DeriveLF = 跟随文件原有风格
LineEnding: DeriveLF

# 宏块开始/结束标记（用于识别宏包裹的代码块）
MacroBlockBegin: ''
MacroBlockEnd: ''

# 主头文件引用方式：Quote = 用 "" 而非 <>
MainIncludeChar: Quote

# 最多保留连续空行数：1
MaxEmptyLinesToKeep: 1

# 命名空间内容缩进：None = 不缩进
NamespaceIndentation: All

# 数字字面量大小写：Leave = 保持原样
NumericLiteralCase:
  ExponentLetter: Leave
  HexDigit: Leave
  Prefix: Leave
  Suffix: Leave

# Objective-C 相关（对 C++ 无影响）
ObjCBinPackProtocolList: Auto
ObjCBlockIndentWidth: 2
ObjCBreakBeforeNestedBlockParam: true
ObjCSpaceAfterProperty: false
ObjCSpaceBeforeProtocolList: true

# 单行格式化关闭正则（匹配到的行不格式化）
OneLineFormatOffRegex: ''

# 构造初始化列表打包：BinPack = 尽量打包
PackConstructorInitializers: BinPack

# 各种换行惩罚值（数值越大越避免换行）
PenaltyBreakAssignment: 2
PenaltyBreakBeforeFirstCallParameter: 19
PenaltyBreakBeforeMemberAccess: 150
PenaltyBreakComment: 300
PenaltyBreakFirstLessLess: 120
PenaltyBreakOpenParenthesis: 0
PenaltyBreakScopeResolution: 500
PenaltyBreakString: 1000
PenaltyBreakTemplateDeclaration: 10
PenaltyExcessCharacter: 1000000
PenaltyIndentedWhitespace: 0
PenaltyReturnTypeOnItsOwnLine: 1000

# 指针/引用对齐：Left = 靠左（int* p）
PointerAlignment: Left

# 预处理器缩进宽度：-1 = 跟随 IndentWidth
PPIndentWidth: -1

# 限定符对齐（const/volatile）：Leave = 保持原样
QualifierAlignment: Leave

# 引用对齐：Pointer = 跟随指针设置（即 Left）
ReferenceAlignment: Middle

# 注释重排：Always = 自动调整注释行宽
ReflowComments: Always

# 是否移除 LLVM 风格的大括号：false = 不移除
RemoveBracesLLVM: false

# 移除未换行代码中的空行：false = 不移除
RemoveEmptyLinesInUnwrappedLines: false

# 移除括号：Leave = 保持原样
RemoveParentheses: Leave

# 移除分号：false = 不移除
RemoveSemicolon: false

# requires 子句位置：OwnLine = 单独一行
RequiresClausePosition: OwnLine

# requires 表达式缩进：OuterScope = 外部作用域缩进
RequiresExpressionIndentation: OuterScope

# 定义块分隔：Leave = 保持原样
SeparateDefinitionBlocks: Leave

# 短命名空间行数：1 = 1 行内不特殊处理
ShortNamespaceLines: 1

# 跳过宏定义体：false = 不跳过
SkipMacroDefinitionBody: false

# 排序 #include：Enabled = 开启排序
SortIncludes:
  Enabled: true
  IgnoreCase: false
  IgnoreExtension: false

# Java 静态导入排序：Before = 放前面
SortJavaStaticImport: Before

# using 声明排序：LexicographicNumeric = 字典+数字排序
SortUsingDeclarations: LexicographicNumeric

# C 风格转换后空格：false = 不加空格
SpaceAfterCStyleCast: false

# 逻辑非后空格：false = !a 而非 ! a
SpaceAfterLogicalNot: false

# 操作符关键字后空格：false = 不加
SpaceAfterOperatorKeyword: false

# 模板关键字后空格：true = template<< 有空格
SpaceAfterTemplateKeyword: true

# 指针限定符周围空格：Default = 默认
SpaceAroundPointerQualifiers: Default

# 赋值操作符前空格：true = a = b（有空格）
SpaceBeforeAssignmentOperators: true

# case 冒号前空格：false = case 1:（无空格）
SpaceBeforeCaseColon: false

# C++11 花括号列表前空格：false = vector<int>{1,2}
SpaceBeforeCpp11BracedList: false

# 构造初始化冒号前空格：true = 有空格
SpaceBeforeCtorInitializerColon: true

# 继承冒号前空格：true = 有空格
SpaceBeforeInheritanceColon: true

# JSON 冒号前空格（对 C++ 无意义）
SpaceBeforeJsonColon: false

# 括号前空格：ControlStatements = 控制语句后加空格
SpaceBeforeParens: ControlStatements

# 括号前空格详细选项
SpaceBeforeParensOptions:
  AfterControlStatements: true      # if/for/while 后加空格
  AfterForeachMacros: true           # foreach 宏后加空格
  AfterFunctionDefinitionName: false # 函数定义名后不加
  AfterFunctionDeclarationName: false # 函数声明名后不加
  AfterIfMacros: true                # if 宏后加空格
  AfterNot: false                    # not 后不加
  AfterOverloadedOperator: false      # 重载操作符后不加
  AfterPlacementOperator: true       # placement new 后加空格
  AfterRequiresInClause: false
  AfterRequiresInExpression: false
  BeforeNonEmptyParentheses: false

# 范围 for 循环冒号前空格：true = 加空格
SpaceBeforeRangeBasedForLoopColon: true

# 方括号前空格：false = a[0] 不加空格
SpaceBeforeSquareBrackets: false

# 空花括号内空格：Never = {} 不加空格
SpaceInEmptyBraces: Never

# 行尾注释前空格数：1 = 一个空格
SpacesBeforeTrailingComments: 1

# 尖括号内空格：Never = vector<int> 不加空格
SpacesInAngles: Never

# 容器字面量内空格：true = {1, 2, 3} 逗号后有空格
SpacesInContainerLiterals: true

# 行注释前缀空格
SpacesInLineCommentPrefix:
  Minimum: 1   # 最少 1 个空格
  Maximum: -1  # 无上限

# 圆括号内空格：Never = 不加
SpacesInParens: Never

# 圆括号内空格详细选项
SpacesInParensOptions:
  ExceptDoubleParentheses: false
  InCStyleCasts: false
  InConditionalStatements: false
  InEmptyParentheses: false
  Other: false

# 方括号内空格：false = a[0] 不加
SpacesInSquareBrackets: false

# C++ 标准：Latest = 最新标准
Standard: Latest

# 类似属性的宏
StatementAttributeLikeMacros:
  - Q_EMIT

# 语句宏（识别为完整语句，不内联格式化）
StatementMacros:
  - Q_UNUSED
  - QT_REQUIRE_VERSION

# TableGen 专用（忽略）
TableGenBreakInsideDAGArg: DontBreak

# Tab 宽度：4
TabWidth: 4

# 使用 Tab：Always = 缩进和对齐都用 Tab
UseTab: Always

# Verilog 专用（忽略）
VerilogBreakBetweenInstancePorts: true

# 空白敏感宏（格式化时保护这些宏内部的空格）
WhitespaceSensitiveMacros:
  - BOOST_PP_STRINGIZE
  - CF_SWIFT_NAME
  - NS_SWIFT_NAME
  - PP_STRINGIZE
  - STRINGIZE

# 命名空间体空行：Leave = 保持原样
WrapNamespaceBodyWithEmptyLines: Leave